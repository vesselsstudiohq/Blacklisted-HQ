---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  loading?: boolean;
}
const { title, description, loading = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL("/media/og_image_dark_1200x630.png", Astro.site);
// LocalBusiness data per BASE-RULES 3.4, matching the Google Business Profile (geo from Sid's pin).
// Phone, street, postcode and hours appear only once they are filled in data/site.ts.
const biz = site.business;
const vesselsHQ = {
  "@type": "Organization",
  name: "Vessels HQ",
  url: "https://www.instagram.com/vesselshq/",
  sameAs: ["https://www.instagram.com/vesselshq/"],
};
const store = {
  "@type": "ClothingStore",
  "@id": new URL("/#store", Astro.site).toString(),
  name: site.name,
  alternateName: `${site.name} by ${site.parent}`,
  brand: { "@type": "Brand", name: site.parent },
  slogan: site.tagline,
  description,
  url: Astro.site?.toString(),
  image: og.toString(),
  logo: new URL("/media/icon-192.png", Astro.site).toString(),
  address: {
    "@type": "PostalAddress",
    ...(biz.streetAddress && { streetAddress: biz.streetAddress }),
    addressLocality: site.city,
    addressRegion: site.region,
    ...(biz.postalCode && { postalCode: biz.postalCode }),
    addressCountry: "IN",
  },
  ...(biz.telephone && { telephone: biz.telephone }),
  ...(biz.hours.length && {
    openingHoursSpecification: biz.hours.map((h) => ({ "@type": "OpeningHoursSpecification", dayOfWeek: h.days, opens: h.opens, closes: h.closes })),
  }),
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.maps,
  sameAs: [site.instagramStore, site.instagramOwner],
};
const website = {
  "@type": "WebSite",
  "@id": new URL("/#website", Astro.site).toString(),
  name: site.name,
  url: Astro.site?.toString(),
  about: { "@id": store["@id"] },
  ...(site.credit && { creator: vesselsHQ }),
};
const jsonLd = { "@context": "https://schema.org", "@graph": [store, website] };
---
<!doctype html>
<html lang="en" class:list={[{ "is-loading": loading }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {site.credit && <meta name="author" content="Vessels HQ" />}
    {!site.indexable && <meta name="robots" content="noindex" />}
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d1411" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/media/favicon_32x32.png" />
    <link rel="apple-touch-icon" href="/media/apple_touch_icon_180x180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BLACKLISTED" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="geo.region" content="IN-TG" />
    <meta name="geo.placename" content="Nizamabad" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
    <link rel="preload" href="/fonts/Orbitron-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/vendor/vessels-glass/vessels-glass.css" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline src="/vendor/vessels-glass/vessels-glass.js" defer></script>
  </head>
  <body class="bg-meadow text-bone">
    <slot />
  </body>
</html>
