---
import GlassButton from "../components/GlassButton.astro";
import { site } from "../data/site";
---
<section id="visit" class="bl-aurora relative overflow-hidden px-4 py-28 md:px-8 md:py-40" aria-labelledby="visit-title">
  <div data-reveal class="relative mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-[1.25fr_1fr] md:gap-20">
    <div>
      <p data-reveal-item class="mb-5 font-mono text-xs tracking-[0.3em] text-honey">VISIT THE STORE</p>
      <h2 id="visit-title" data-reveal-item class="font-display text-[clamp(2.6rem,9vw,7rem)] leading-[0.9] font-black tracking-tight text-bone">
        {site.city.toUpperCase()}<span class="text-bone/40">*</span>
      </h2>
      <p data-reveal-item class="mt-7 max-w-md text-lg leading-relaxed text-bone/80">
        Right where the Trend Maker salon used to be. One store, built from the ground up: walk in, try it on, wear it out.
      </p>
      <div data-reveal-item class="mt-10 flex flex-wrap gap-3">
        <GlassButton accent href={site.directions}>Get directions</GlassButton>
        <GlassButton href={site.instagramStore}>DM to order</GlassButton>
      </div>
    </div>

    <article data-reveal-item data-vg="card" data-vg-size="lg" data-vg-intensity="0.7" class="relative [--vg-pad:2rem] [--vg-radius:28px]">
      <canvas id="visit-spin" class="mx-auto block size-40 md:size-52" aria-hidden="true"></canvas>
      <p class="mt-6 text-center font-display text-xl font-black tracking-tight text-bone">BLACKLISTED</p>
      <p class="mt-1 text-center font-mono text-[0.65rem] tracking-[0.25em] text-bone/60">BY {site.parent}®</p>
      <div class="mt-7 border-t border-bone/15 pt-5 text-center">
        <p class="text-sm text-bone/80">{site.city}, {site.region}</p>
        <a href={site.maps} data-maps-desktop={site.mapsDesktop} target="_blank" rel="noopener" class="mt-2 inline-block font-mono text-[0.7rem] tracking-[0.2em] text-honey underline-offset-4 hover:underline">OPEN IN GOOGLE MAPS ↗</a>
      </div>
    </article>
  </div>
</section>
