---
import KnotMark from "./KnotMark.astro";
// The studio's signature. Turn it off for a paying client with `credit: false` in data/site.ts.
// `compact` is the loader's version: smaller, and plain text (the loader isn't interactive).
interface Props {
  label?: string;
  href?: string;
  compact?: boolean;
  class?: string;
}
const { label = "Designed & built by", href = "https://www.instagram.com/vesselshq/", compact = false, class: cls } = Astro.props;
const size = compact
  ? { gap: "gap-3", mark: "h-5", rule: "h-5", eyebrow: "text-[10px] text-white/55", name: "text-[15px]" }
  : { gap: "gap-4", mark: "h-7 md:h-8", rule: "h-7", eyebrow: "text-[11px] text-white/60", name: "text-[clamp(1.125rem,1rem+0.5vw,1.375rem)]" };
---
<!-- The link's own text is the brand name only; its ::after stretches over the whole credit so all of it is clickable. -->
<div
  class:list={[
    "group inline-flex items-center text-white",
    size.gap,
    compact && "pointer-events-none select-none",
    !compact && "relative min-h-11 rounded-sm py-2 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-white",
    cls,
  ]}
>
  <KnotMark class={`${size.mark} w-auto shrink-0 transition-transform duration-200 motion-safe:group-hover:rotate-[8deg] motion-safe:group-has-[a:focus-visible]:rotate-[8deg]`} />
  <span class={`${size.rule} w-px shrink-0 bg-white/25`} aria-hidden="true"></span>
  <span class="flex flex-col items-start gap-1 text-left leading-none">
    <span class={`${size.eyebrow} font-mono font-medium tracking-[0.22em] uppercase transition-colors duration-200 group-hover:text-white group-has-[a:focus-visible]:text-white`}>{label}</span>
    {compact ? (
      <span class={`${size.name} font-sans font-medium tracking-[0.14em] text-white uppercase`}>Vessels HQ</span>
    ) : (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Designed and built by Vessels HQ (opens Instagram in a new tab)"
        class={`${size.name} font-sans font-medium tracking-[0.14em] text-white uppercase outline-none after:absolute after:inset-0 after:content-['']`}
      >Vessels HQ</a>
    )}
  </span>
</div>
