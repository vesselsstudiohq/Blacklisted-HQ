---
import Base from "../layouts/Base.astro";
import Footer from "../sections/Footer.astro";
interface Props {
  title: string;
  description: string;
  heading: string;
  updated: string;
}
const { title, description, heading, updated } = Astro.props;
---
<Base title={title} description={description}>
  <main class="mx-auto max-w-3xl px-4 pt-28 pb-24 md:px-8">
    <a href="/" class="font-mono text-xs tracking-[0.25em] text-honey hover:text-bone">← BLACKLISTED</a>
    <h1 class="mt-8 font-display text-4xl font-black tracking-tight text-bone md:text-6xl">{heading}</h1>
    <p class="mt-3 font-mono text-xs tracking-[0.2em] text-bone/50">LAST UPDATED {updated}</p>
    <div class="mt-12 space-y-8 text-base leading-relaxed text-bone/85 [&_h2]:mb-3 [&_h2]:font-sans [&_h2]:text-lg [&_h2]:font-bold [&_h2]:text-bone">
      <slot />
    </div>
  </main>
  <Footer />
</Base>
