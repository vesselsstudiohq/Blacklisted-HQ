---
// Vessels Glass call to action, rendered as a link. `accent` = Store Glass Vermilion tint: the ONE
// primary CTA (palette law). External links open in a new tab.
interface Props {
  href: string;
  accent?: boolean;
  class?: string;
}
const { href, accent = false, class: cls } = Astro.props;
const external = /^https?:/.test(href);
---
<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  data-vg="button"
  data-vg-size="lg"
  data-vg-intensity="0.75"
  data-tone={accent ? "accent" : undefined}
  class:list={["inline-flex items-center gap-2 font-sans text-sm font-semibold tracking-[0.06em] text-bone uppercase", cls]}
>
  <slot />
  <span aria-hidden="true" class="text-bone/70">↗</span>
</a>
